/* Expose the active theme tokens as Tailwind utilities (bg-site-bg, etc.). */
@theme inline {
  --animate-enter-soft: enter-soft 650ms cubic-bezier(0.22, 1, 0.36, 1) both;

  @keyframes enter-soft {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  --font-sans: Inter, Arial, sans-serif;
  --color-site-bg: var(--site-bg);
  --color-site-panel: var(--site-panel);
  --color-site-ink: var(--site-ink);
  --color-site-muted: var(--site-muted);
  --color-site-border: var(--site-border);
  --color-site-accent: var(--site-accent);
  --color-site-ink-blue: var(--site-ink-blue);
  --color-site-glow: var(--site-glow);
  --color-site-halo: var(--site-halo);
  --color-site-title-end: var(--site-title-end);
  --color-site-soft: var(--site-soft);
  --color-site-grid: var(--site-grid);
  --color-site-selection: var(--site-selection);
  --color-site-mini-highlight: var(--site-mini-highlight);
  --color-site-gradient-text: var(--site-gradient-text);
  --color-site-fill: var(--site-fill);
  --color-site-on: var(--site-on);
  --color-site-fill-shadow: var(--site-fill-shadow);
  --color-site-secondary: var(--site-secondary);
  --color-site-secondary-on: var(--site-secondary-on);
  --color-site-secondary-shadow: var(--site-secondary-shadow);
  --color-site-shadow-raised: var(--site-shadow-raised);
  --color-site-shadow-soft: var(--site-shadow-soft);
  --color-site-shadow-button: var(--site-shadow-button);
  --color-site-shadow-browser: var(--site-shadow-browser);
}

[data-section="contacto"] a {
  color: var(--site-accent);
}
